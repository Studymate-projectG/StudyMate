rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function ok() {
      return request.auth != null
        && request.auth.token.email.lower().matches('.*@university[.]edu[.]sa$');
    }

    function leader() {
      return ok() && resource.data.leader == request.auth.uid;
    }

    function member() {
      return ok() && request.auth.uid in resource.data.members;
    }

    function open() {
      return !resource.data.closed && resource.data.time > request.time;
    }

    function after() {
      return request.resource.data;
    }

    function fields() {
      return ['title', 'desc', 'course', 'max', 'time', 't'];
    }

    function valid() {
      return after().title is string && after().title.size() > 0 && after().title.size() <= 60
        && after().course is string && after().course.size() > 0
        && after().desc is string && after().desc.size() <= 200
        && after().max is int && after().max > 1 && after().max <= 30
        && after().time is string && after().time.size() >= 16
        && after().t is int && after().t > request.time.toMillis();
    }
    function same() {
      return after().title == resource.data.title
        && after().course == resource.data.course
        && after().desc == resource.data.desc
        && after().max == resource.data.max
        && after().time == resource.data.time;
    }

    match /users/{id} {
      allow read: if ok();
      allow write: if ok() && request.auth.uid == id;
    }

    match /groups/{id} {
      allow read: if ok();

      allow create: if ok()
        && after().leader == request.auth.uid
        && after().leaderName is string
        && after().members == [request.auth.uid]
        && after().closed == false
        && after().max >= 2
        && after().t is int && after().t > request.time.toMillis()
        && after().title is string && after().title.size() > 0 && after().title.size() <= 60
        && after().course is string && after().course.size() > 0
        && after().desc is string && after().desc.size() <= 200;

      allow update: if ok() && (
        (ok() && resource.data.leader != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && !(request.auth.uid in resource.data.members)
          && after().members.hasAll(resource.data.members)
          && request.auth.uid in after().members
          && after().members.size() == resource.data.members.size() + 1
          && after().members.size() <= resource.data.max
          && !resource.data.closed
          && resource.data.t > request.time.toMillis())
        ||
        (member() && resource.data.leader != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.auth.uid in resource.data.members
          && !(request.auth.uid in after().members)
          && resource.data.leader in after().members
          && after().members.size() == resource.data.members.size() - 1
          && after().members == resource.data.members.removeAll([request.auth.uid]))
        ||
        (leader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields())
          && valid()
          && after().max >= resource.data.members.size())
        ||
        (leader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
          && after().closed is bool
          && after().closed == !resource.data.closed
          && after().closed == true)
        ||
        (leader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members.hasAll(after().members)
          && request.auth.uid in after().members
          && after().members.size() < resource.data.members.size()
          && after().members.size() == resource.data.members.size() - 1)
      );

      match /notes/{nid} {
        allow read: if ok() && request.auth.uid in get(/databases/$(db)/documents/groups/$(id)).data.members;
        allow create: if ok()
          && request.auth.uid == get(/databases/$(db)/documents/groups/$(id)).data.leader
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.author == request.auth.uid
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
